{
    "compilerOptions": {
        // VS Code 1.53 is based on Node 12.18.3 which has compat up to ES2020.
        "module": "ES2022",
        "target": "ES2022",
        "esModuleInterop": true,
        "noImplicitAny": true,
        "moduleResolution": "bundler",
        // The dependency publishes JavaScript under out/src and declarations under lib/src.
        "paths": {
            "vscode-chrome-debug-core/out/src/*": [
                "./node_modules/vscode-chrome-debug-core/lib/src/*"
            ]
        },
        // TypeScript 6 no longer includes every node_modules/@types package
        // automatically, so the ambient globals used here must be listed.
        "types": [
            "node",
            "jest"
        ],
        "sourceMap": true,
        "outDir": "out",
        "skipLibCheck": true,
        "noUnusedLocals": true,
        "strict": true,
        "resolveJsonModule": true
    },
    "include": [
        "./**/*"
    ]
}
